# Mercearia da Esquina — configuração do Apache (XAMPP e a maioria das hospedagens)
Options -Indexes
DirectoryIndex index.html

# Não deixa baixar arquivos internos
<FilesMatch "^(README\.md|\.htaccess|\.gitignore)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "same-origin"
</IfModule>
